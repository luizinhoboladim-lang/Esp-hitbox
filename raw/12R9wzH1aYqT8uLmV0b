    toggle.Text = initialValue and "ON" or "OFF"
    toggle.TextColor3 = initialValue and Color3.new(1, 1, 1) or THEME.SubText
    toggle.Font = Enum.Font.GothamBold
    toggle.TextSize = 10
    toggle.AutoButtonColor = false
    toggle.Parent = frame
    
    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(0, 3)
    toggleCorner.Parent = toggle
    
    local toggleStroke = Instance.new("UIStroke")
    toggleStroke.Color = THEME.BorderLight
    toggleStroke.Thickness = 1
    toggleStroke.Parent = toggle
    
    local state = initialValue
    
    local function update()
        if state then
            toggle.BackgroundColor3 = THEME.Success
            toggle.Text = "ON"
            toggle.TextColor3 = Color3.new(1, 1, 1)
        else
            toggle.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            toggle.Text = "OFF"
            toggle.TextColor3 = THEME.SubText
        end
    end
    
    toggle.MouseButton1Click:Connect(function()
        state = not state
        update()
        if callback then callback(state) end
    end)
    
    update()
    
    return function(v)
        state = v
        update()
    end
end

