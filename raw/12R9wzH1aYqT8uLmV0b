    valueLabel.Text = tostring(initialValue)
    valueLabel.TextColor3 = THEME.Accent2
    valueLabel.TextSize = 12
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.ZIndex = 4
    valueLabel.Parent = frame
    
    local sliderBG = Instance.new("Frame")
    sliderBG.Size = UDim2.new(1, -24, 0, 6)
    sliderBG.Position = UDim2.new(0, 12, 0, 38)
    sliderBG.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    sliderBG.BorderSizePixel = 0
    sliderBG.ZIndex = 4
    sliderBG.Parent = frame
    
    local sliderBGStroke = Instance.new("UIStroke")
    sliderBGStroke.Color = THEME.Border
    sliderBGStroke.Thickness = 1
    sliderBGStroke.Parent = sliderBG
    
    local sliderFill = Instance.new("Frame")
    sliderFill.Size = UDim2.new((initialValue - minVal) / (maxVal - minVal), 0, 1, 0)
    sliderFill.BackgroundColor3 = THEME.Accent1
    sliderFill.BorderSizePixel = 0
    sliderFill.ZIndex = 5
    sliderFill.Parent = sliderBG
    
    local sliderFillGradient = Instance.new("UIGradient")
    sliderFillGradient.Color = ColorSequence.new(THEME.Accent1, THEME.Accent2)
    sliderFillGradient.Parent = sliderFill
    
    local sliderKnob = Instance.new("TextButton")
    sliderKnob.Size = UDim2.new(0, 12, 0, 12)
    sliderKnob.Position = UDim2.new((initialValue - minVal) / (maxVal - minVal), -6, 0.5, -6)
    sliderKnob.BackgroundColor3 = Color3.new(1, 1, 1)
    sliderKnob.Text = ""
    sliderKnob.AutoButtonColor = false
    sliderKnob.ZIndex = 6
    sliderKnob.Parent = sliderBG
    
    local sliderKnobCorner = Instance.new("UICorner")
    sliderKnobCorner.CornerRadius = UDim.new(0, 2)
    sliderKnobCorner.Parent = sliderKnob
    
    local dragging = false
    local currentValue = initialValue
    
    local function updateFromPosition(x)
        local relativeX = math.clamp((x - sliderBG.AbsolutePosition.X) / sliderBG.AbsoluteSize.X, 0, 1)
        local value = math.floor(minVal + relativeX * (maxVal - minVal) + 0.5)
        currentValue = value
        valueLabel.Text = tostring(value)
        sliderFill.Size = UDim2.new(relativeX, 0, 1, 0)
        sliderKnob.Position = UDim2.new(relativeX, -6, 0.5, -6)
        if callback then callback(value) end
    end
    
    sliderKnob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    
    sliderBG.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromPosition(input.Position.X)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromPosition(input.Position.X)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    return function(v)
        currentValue = v
        local rel = (v - minVal) / (maxVal - minVal)
        valueLabel.Text = tostring(v)
        sliderFill.Size = UDim2.new(rel, 0, 1, 0)
        sliderKnob.Position = UDim2.new(rel, -6, 0.5, -6)
    end
end

-- ═══ SELETOR CICLO (substitui dropdown - sem bugs) ═══
local function makeDropdown(parent, text, options, initialValue, callback)
    local frame = Instance.new("Frame")
    frame.Name = text
    frame.Size = UDim2.new(1, 0, 0, 32)
    frame.BackgroundColor3 = THEME.Panel
    frame.BorderSizePixel = 0
    frame.ZIndex = 3
    frame.Parent = parent
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 3)
    corner.Parent = frame
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = THEME.Border
    stroke.Thickness = 1
    stroke.Parent = frame
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -100, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.Gotham
    label.Text = text
    label.TextColor3 = THEME.Text
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 4
    label.Parent = frame
    
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 80, 0, 22)
    button.Position = UDim2.new(1, -92, 0.5, -11)
    button.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    button.Text = ""
    button.AutoButtonColor = false
    button.ZIndex = 4
    button.Parent = frame
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 3)
    btnCorner.Parent = button
    
    local btnStroke = Instance.new("UIStroke")
    btnStroke.Color = THEME.BorderLight
    btnStroke.Thickness = 1
    btnStroke.Parent = button
    
    local arrow = Instance.new("TextLabel")
    arrow.Size = UDim2.new(1, 0, 1, 0)
    arrow.BackgroundTransparency = 1
    arrow.Font = Enum.Font.GothamBold
    arrow.Text = initialValue .. "  >"
    arrow.TextColor3 = THEME.Accent2
    arrow.TextSize = 11
    arrow.TextXAlignment = Enum.TextXAlignment.Center
    arrow.ZIndex = 5
    arrow.Parent = button
    
    local currentIndex = 1
    for i, opt in ipairs(options) do
        if opt == initialValue then
            currentIndex = i
            break
        end
    end
    
    local function updateDisplay()
        arrow.Text = options[currentIndex] .. "  >"
        if callback then callback(options[currentIndex]) end
    end
    
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.15), {BackgroundColor3 = THEME.PanelLight}):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(30, 30, 30)}):Play()
    end)
    
    button.MouseButton1Click:Connect(function()
        currentIndex = currentIndex + 1
        if currentIndex > #options then
            currentIndex = 1
        end
        updateDisplay()
    end)
    
    return function(v)
        for i, opt in ipairs(options) do
            if opt == v then
                currentIndex = i
                updateDisplay()
                break
            end
        end
    end
end

