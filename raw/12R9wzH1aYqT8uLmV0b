local COLOR_ALLY = Color3.fromRGB(60, 190, 110)
local COLOR_ENEMY = Color3.fromRGB(255, 80, 80)
local COLOR_NEUTRAL = Color3.fromRGB(240, 240, 240)
local COLOR_DEAD = Color3.fromRGB(120, 120, 120)

local function applyBillboardStyle(billboard, label, color)
    if not billboard or not label then return end
    
    label.TextSize = Config.NameFontSize
    label.TextTransparency = Config.NameTransparency
    label.TextStrokeTransparency = math.min(1, Config.NameTransparency + 0.2)
    label.TextColor3 = color or COLOR_NEUTRAL
    
    billboard.Size = UDim2.new(0, 200, 0, math.max(24, Config.NameFontSize + 12))
end

local function createBillboard(head)
    if not head or not head:IsA("BasePart") then return nil end
    
    local existing = head:FindFirstChild(Config.BillboardName)
    if existing then
        local label = existing:FindFirstChild("Label")
        if label then applyBillboardStyle(existing, label) end
        return existing
    end
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = Config.BillboardName
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 200, 0, 28)
    billboard.StudsOffset = Vector3.new(0, 2.2, 0)
    billboard.AlwaysOnTop = true
    billboard.ResetOnSpawn = false
    billboard.Enabled = false
    
    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = COLOR_NEUTRAL
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextStrokeTransparency = 0.4
    label.Font = Enum.Font.GothamBold
    label.TextScaled = false
    label.TextSize = Config.NameFontSize
    label.RichText = false
    label.Text = ""
    label.Parent = billboard
    
    billboard.Parent = head
    return billboard
end

local function setupTarget(character, player)
    if targetCache[character] then return end
    
    local head = character:FindFirstChild("Head")
    if not head then return end
    
    local billboard = createBillboard(head)
    local label = billboard and billboard:FindFirstChild("Label")
    
    targetCache[character] = {
        character = character,
        head = head,
        billboard = billboard,
        label = label,
        player = player,
        name = player and player.Name or character.Name,
        shortName = shortenName(player and player.Name or character.Name, Config.MaxNameLength),
    }
    
    table.insert(activeTargets, character)
end

local function removeTarget(character)
    local data = targetCache[character]
    if data then
        if data.billboard then data.billboard:Destroy() end
        targetCache[character] = nil
        
        for i, c in ipairs(activeTargets) do
            if c == character then
                table.remove(activeTargets, i)
                break
            end
        end
    end
end

local function updateTarget(character)
    local data = targetCache[character]
    if not data then return end
    
    local head = data.head
    local billboard = data.billboard
    local label = data.label
    local player = data.player
    
    if not head or not head.Parent then
        removeTarget(character)
        return
    end
    
    if not billboard or not billboard.Parent then
        data.billboard = createBillboard(head)
        data.label = data.billboard and data.billboard:FindFirstChild("Label")
        billboard = data.billboard
        label = data.label
    end
    
    if not billboard or not label then return end
    
    if not Config.ESPEnabled then
        if billboard.Enabled then billboard.Enabled = false end
        return
    end
    
    if player then
        if player == LocalPlayer then
            if billboard.Enabled then billboard.Enabled = false end
            return
        end
        
        local ally = isAlly(player)
        local dead = isDeadPlayer(player)
        
        if ally and not Config.ShowTeam then
            if billboard.Enabled then billboard.Enabled = false end
            return
        end
        
        if not ally and not Config.ShowEnemies then
            if billboard.Enabled then billboard.Enabled = false end
            return
        end
        
        if dead and not Config.ShowDead then
            if billboard.Enabled then billboard.Enabled = false end
            return
        end
        
        local color
        if dead then
            color = COLOR_DEAD
        elseif ally then
            color = COLOR_ALLY
        elseif Config.HighlightEnemies then
            color = COLOR_ENEMY
        else
            color = COLOR_NEUTRAL
        end
        
        applyBillboardStyle(billboard, label, color)
    end
    
    if Config.MaxDistance and Config.MaxDistance > 0 then
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myRoot then
            local dist = (head.Position - myRoot.Position).Magnitude
            if dist > Config.MaxDistance then
                if billboard.Enabled then billboard.Enabled = false end
                return
            end
        end
    end
    
    if label.Text ~= data.shortName then
        label.Text = data.shortName
    end
    
    if not billboard.Enabled then
        billboard.Enabled = true
    end
end

local function setESPEnabled(enabled)
    Config.ESPEnabled = enabled
    
    if not enabled then
        for _, data in pairs(targetCache) do
            if data.billboard then data.billboard.Enabled = false end
        end
    end
    persistConfig()
end

