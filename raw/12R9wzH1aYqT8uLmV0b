local function switchTab(tabName)
    for name, frame in pairs(tabs) do
        frame.Visible = (name == tabName)
    end
    for name, btn in pairs(tabButtons) do
        if name == tabName then
            btn.BackgroundColor3 = THEME.PanelLight
            local label = btn:FindFirstChild("Label")
            if label then label.TextColor3 = THEME.Accent2 end
            local indicator = btn:FindFirstChild("Indicator")
            if indicator then indicator.Visible = true end
        else
            btn.BackgroundColor3 = THEME.Panel
            local label = btn:FindFirstChild("Label")
            if label then label.TextColor3 = THEME.SubText end
            local indicator = btn:FindFirstChild("Indicator")
            if indicator then indicator.Visible = false end
        end
    end
    currentTabName = tabName
    Config.CurrentTab = tabName
    persistConfig()
end

