local function shortenName(name, maxLen)
    if not name then return "" end
    maxLen = maxLen or 24
    if #name > maxLen then
        return string.sub(name, 1, maxLen - 3) .. "..."
    end
    return name
end

local function updateMyTeam()
    myTeam = LocalPlayer.Team
end

local function isAlly(player)
    if player == LocalPlayer then return true end
    if not myTeam then updateMyTeam() end
    if myTeam and player.Team then
        return player.Team == myTeam
    end
    return false
end

local function isDeadPlayer(player)
    if player == LocalPlayer then return false end
    local char = player.Character
    if not char then return true end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return true end
    if humanoid.Health <= 0 then return true end
    if humanoid:GetState() == Enum.HumanoidStateType.Dead then return true end
    return false
end

