-- HOTKEY HANDLER (SINCRONIZADO)
-- ═══════════════════════════════════════════════════════════════

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if activeKeybindListener then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    
    local key = input.KeyCode
    local keyName = key.Name
    
    if key == Config.KeybindToggleGUI then
        mainFrame.Visible = not mainFrame.Visible
        return
    end
    
    if gameProcessed then return end
    
    if key == Config.KeybindToggleAll then
        local newState = not (Config.HitboxEnabled and Config.ESPEnabled)
        setHitboxEnabled(newState)
        setESPEnabled(newState)
        if setHitboxToggleVisual then setHitboxToggleVisual(newState) end
        if setESPToggleVisual then setESPToggleVisual(newState) end
        return
    end
    
    if key == Config.KeybindToggleHitbox then
        local newState = not Config.HitboxEnabled
        setHitboxEnabled(newState)
        if setHitboxToggleVisual then setHitboxToggleVisual(newState) end
        return
    end
    
    if key == Config.KeybindToggleESP then
        local newState = not Config.ESPEnabled
        setESPEnabled(newState)
        if setESPToggleVisual then setESPToggleVisual(newState) end
        return
    end
    
    if key == Config.KeybindToggleAimbot then
        if Config.AimbotMode == "Toggle" then
            local newState = not Config.AimbotEnabled
            setAimbotEnabled(newState)
            if setAimbotToggleVisual then setAimbotToggleVisual(newState) end
        else
            aimbotIsHolding = true
        end
        return
    end
    
    if Config.Hotkeys then
        for id, savedKey in pairs(Config.Hotkeys) do
            if savedKey and savedKey ~= "" and savedKey ~= "None" and savedKey == keyName then
                if id == "HitboxToggle" then
                    local newState = not Config.HitboxEnabled
                    setHitboxEnabled(newState)
                    if setHitboxToggleVisual then setHitboxToggleVisual(newState) end
                elseif id == "ESPToggle" then
                    local newState = not Config.ESPEnabled
                    setESPEnabled(newState)
                    if setESPToggleVisual then setESPToggleVisual(newState) end
                elseif id == "AimbotToggle" then
                    local newState = not Config.AimbotEnabled
                    setAimbotEnabled(newState)
                    if setAimbotToggleVisual then setAimbotToggleVisual(newState) end
                end
            end
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if input.KeyCode == Config.KeybindToggleAimbot and Config.AimbotMode == "Hold" then
        aimbotIsHolding = false
    end
end)

