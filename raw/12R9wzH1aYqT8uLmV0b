local aimbotFOVRing = Drawing.new("Circle")
aimbotFOVRing.Visible = false
aimbotFOVRing.Thickness = 2
aimbotFOVRing.Color = Color3.fromRGB(114, 88, 255)
aimbotFOVRing.Filled = false
aimbotFOVRing.Radius = Config.AimbotFOV
aimbotFOVRing.Position = Camera.ViewportSize / 2
aimbotFOVRing.Transparency = 0.4

local aimbotIsHolding = false

local function setAimbotEnabled(enabled)
    Config.AimbotEnabled = enabled
    aimbotFOVRing.Visible = enabled and Config.AimbotDrawFOV
    persistConfig()
end

local function getClosestTargetInFOV()
    local closest = nil
    local lastDist = math.huge
    local centerPos = Camera.ViewportSize / 2
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local canTarget = true
            if Config.AimbotIgnoreDead and isDeadPlayer(player) then canTarget = false end
            if Config.AimbotTeamCheck and isAlly(player) then canTarget = false end
            
            if canTarget then
                local part = player.Character:FindFirstChild(Config.AimbotTarget)
                if part then
                    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                    if humanoid and humanoid.Health > 0 then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - centerPos).Magnitude
                            if dist < lastDist and dist < Config.AimbotFOV then
                                lastDist = dist
                                closest = player
                            end
                        end
                    end
                end
            end
        end
    end
    
    return closest
end

RunService.RenderStepped:Connect(function()
    if not Config.AimbotEnabled then return end
    if Config.AimbotMode == "Hold" and not aimbotIsHolding then return end
    
    if Config.AimbotDrawFOV then
        aimbotFOVRing.Position = Camera.ViewportSize / 2
        aimbotFOVRing.Radius = Config.AimbotFOV
    end
    
    local target = getClosestTargetInFOV()
    if target and target.Character then
        local targetPart = target.Character:FindFirstChild(Config.AimbotTarget)
        if targetPart then
            local camPos = Camera.CFrame.Position
            local targetPos = targetPart.Position
            local lookVector = (targetPos - camPos).Unit
            local newCFrame = CFrame.new(camPos, camPos + lookVector)
            local smooth = math.clamp(Config.AimbotSmoothness, 0, 1)
            Camera.CFrame = Camera.CFrame:Lerp(newCFrame, 1 - smooth)
        end
    end
end)

