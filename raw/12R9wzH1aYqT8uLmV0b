local function shortenName(name, maxLen)
    if not name then return "" end
    maxLen = maxLen or 12
    if #name > maxLen then
        return string.sub(name, 1, maxLen - 3) .. "..."
    end
    return name
end

-- ═══════════════════════════════════════════════════════════════
-- HITBOX EXPANDER
-- ═══════════════════════════════════════════════════════════════

local function transformHead(character)
    if modifiedCharacters[character] then return end
    
    local head = character:FindFirstChild("Head")
    if not head then return end
    
    if head.Size.X >= 5 then
        modifiedCharacters[character] = true
        return
    end
    
    local originalColor = head.Color
    local originalMaterial = head.Material
    
    local originalMesh = nil
    local meshChild = head:FindFirstChildOfClass("SpecialMesh")
    if meshChild then
        originalMesh = meshChild:Clone()
    end
    
    local originalDecal = nil
    local decalChild = head:FindFirstChildOfClass("Decal")
    if decalChild then
        originalDecal = decalChild:Clone()
    end
    
    head.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
    head.Shape = Enum.PartType.Ball
    head.Transparency = 1
    head.Material = Enum.Material.ForceField
    head.CanCollide = false
    head.Massless = true
    
    for _, v in pairs(head:GetChildren()) do
        if v:IsA("SpecialMesh") or v:IsA("Decal") or v:IsA("SurfaceAppearance") then
            v:Destroy()
        end
    end
    
    local fakeHead = Instance.new("Part")
    fakeHead.Name = "FakeHead"
    fakeHead.Size = Vector3.new(2, 1, 1)
    fakeHead.Transparency = 0
    fakeHead.CanCollide = false
    fakeHead.Massless = true
    fakeHead.Color = originalColor
    fakeHead.Material = originalMaterial
    fakeHead.TopSurface = Enum.SurfaceType.Smooth
    fakeHead.BottomSurface = Enum.SurfaceType.Smooth
    fakeHead.Parent = head
    
    if originalMesh then
        originalMesh.Parent = fakeHead
    end
    
    if originalDecal then
        originalDecal.Parent = fakeHead
    end
    
    local weld = Instance.new("Weld")
    weld.Part0 = head
    weld.Part1 = fakeHead
    weld.C0 = CFrame.new(0, 0, 0)
    weld.Parent = fakeHead
    
    modifiedCharacters[character] = true
end

local function restoreHead(character)
    if not modifiedCharacters[character] then return end
    
    local head = character:FindFirstChild("Head")
    if head then
        local fakeHead = head:FindFirstChild("FakeHead")
        if fakeHead then
            local decal = fakeHead:FindFirstChildOfClass("Decal")
            if decal then
                decal:Clone().Parent = head
            end
            
            local mesh = fakeHead:FindFirstChildOfClass("SpecialMesh")
            if mesh then
                mesh:Clone().Parent = head
            end
            
            fakeHead:Destroy()
        end
        
        head.Size = Vector3.new(2, 1, 1)
        head.Transparency = 0
        head.Shape = Enum.PartType.Block
        head.Material = Enum.Material.Plastic
    end
    
    modifiedCharacters[character] = nil
end

local function updateHitboxSize(newSize)
    Config.HitboxSize = math.clamp(newSize, 1, 500)
    
    for character, _ in pairs(modifiedCharacters) do
        local head = character:FindFirstChild("Head")
        if head then
            head.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
        end
    end
end

local function setHitboxEnabled(enabled)
    Config.HitboxEnabled = enabled
    
    if enabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                transformHead(player.Character)
            end
        end
    else
        for character, _ in pairs(modifiedCharacters) do
            restoreHead(character)
        end
    end
end

-- ═══════════════════════════════════════════════════════════════
-- ESP SYSTEM
-- ═══════════════════════════════════════════════════════════════

local function applyBillboardStyle(billboard, label)
    if not billboard or not label then return end
    
    -- Tamanho do texto (fonte)
    label.TextSize = Config.NameFontSize
    
    -- Transparência do texto (mantém visível mas suave)
    label.TextTransparency = Config.NameTransparency
    label.TextStrokeTransparency = Config.NameTransparency + 0.2  -- contorno mais leve
    
    -- Ajusta o tamanho do Billboard baseado na fonte
    billboard.Size = UDim2.new(0, 140, 0, math.max(24, Config.NameFontSize + 12))
end

local function createBillboard(head)
    if not head or not head:IsA("BasePart") then return nil end
    
    local existing = head:FindFirstChild(Config.BillboardName)
    if existing then
        local label = existing:FindFirstChild("Label")
        applyBillboardStyle(existing, label)
        return existing
    end
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = Config.BillboardName
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 140, 0, 28)
    billboard.StudsOffset = Vector3.new(0, 2.2, 0)
    billboard.AlwaysOnTop = true
    billboard.ResetOnSpawn = false
    billboard.Enabled = false
    
    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextStrokeTransparency = 0
    label.Font = Enum.Font.GothamBold
    label.TextScaled = false
    label.RichText = false
    label.Text = ""
    label.Parent = billboard
    
    applyBillboardStyle(billboard, label)
    
    billboard.Parent = head
    return billboard
end

local function setupTarget(character, player)
    if targetCache[character] then return end
    
    local head = character:FindFirstChild("Head")
    if not head then return end
    
    local billboard = createBillboard(head)
    local label = billboard and billboard:FindFirstChild("Label")
    
    targetCache[character] = {
        character = character,
        head = head,
        billboard = billboard,
        label = label,
        player = player,
        name = player and player.Name or character.Name,
        shortName = shortenName(player and player.Name or character.Name, Config.MaxNameLength),
    }
    
    table.insert(activeTargets, character)
end

local function removeTarget(character)
    local data = targetCache[character]
    if data then
        if data.billboard then
            data.billboard:Destroy()
        end
        targetCache[character] = nil
        
        for i, c in ipairs(activeTargets) do
            if c == character then
                table.remove(activeTargets, i)
                break
            end
        end
    end
end

local function updateTarget(character)
    local data = targetCache[character]
    if not data then return end
    
    local head = data.head
    local billboard = data.billboard
    local label = data.label
    
    if not head or not head.Parent then
        removeTarget(character)
        return
    end
    
    if not billboard or not billboard.Parent then
        data.billboard = createBillboard(head)
        data.label = data.billboard and data.billboard:FindFirstChild("Label")
        billboard = data.billboard
        label = data.label
    end
    
    if not billboard or not label then return end
    
    if not Config.ESPEnabled then
        if billboard.Enabled then
            billboard.Enabled = false
        end
        return
    end
    
    if Config.MaxDistance and Config.MaxDistance > 0 then
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myRoot then
            local dist = (head.Position - myRoot.Position).Magnitude
            if dist > Config.MaxDistance then
                if billboard.Enabled then
                    billboard.Enabled = false
                end
                return
            end
        end
    end
    
    if not billboard.Enabled then
        billboard.Enabled = true
    end
    
    if label.Text ~= data.shortName then
        label.Text = data.shortName
    end
end

local function setESPEnabled(enabled)
    Config.ESPEnabled = enabled
    
    if not enabled then
        for _, data in pairs(targetCache) do
            if data.billboard then
                data.billboard.Enabled = false
            end
        end
    end
end

-- ═══════════════════════════════════════════════════════════════
-- GERENCIAMENTO DE JOGADORES
-- ═══════════════════════════════════════════════════════════════

local function onCharacterAdded(player, character)
    task.wait(1)
    
    if not character or not character.Parent then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    if player ~= LocalPlayer or Config.ShowLocal then
        setupTarget(character, player)
    end
    
    if player ~= LocalPlayer and Config.HitboxEnabled then
        transformHead(character)
    end
    
    humanoid:GetPropertyChangedSignal("Sit"):Connect(function()
        if humanoid.Sit and player ~= LocalPlayer then
            restoreHead(character)
        elseif not humanoid.Sit and player ~= LocalPlayer and Config.HitboxEnabled then
            task.wait(0.5)
            if character.Parent then
                transformHead(character)
            end
        end
    end)
end

local function onCharacterRemoving(player, character)
    removeTarget(character)
    restoreHead(character)
    modifiedCharacters[character] = nil
end

-- ═══════════════════════════════════════════════════════════════
-- LOOP PRINCIPAL
-- ═══════════════════════════════════════════════════════════════

local function updateAll()
    for i = #activeTargets, 1, -1 do
        local character = activeTargets[i]
        local data = targetCache[character]
        
        if not data or not character.Parent then
            removeTarget(character)
        else
            pcall(updateTarget, character)
        end
    end
end

