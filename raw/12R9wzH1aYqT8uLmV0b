-- HITBOX
-- ═══════════════════════════════════════════════════════════════

local function transformHead(character)
    if modifiedCharacters[character] then return end
    
    local head = character:FindFirstChild("Head")
    if not head then return end
    
    if head.Size.X >= 5 then
        modifiedCharacters[character] = {head = head}
        return
    end
    
    local originalSize = head.Size
    local originalColor = head.Color
    local originalMaterial = head.Material
    local originalShape = head.Shape
    local originalTransparency = head.Transparency
    
    local originalMesh = nil
    local meshChild = head:FindFirstChildOfClass("SpecialMesh")
    if meshChild then
        originalMesh = meshChild:Clone()
        meshChild:Destroy()
    end
    
    local originalDecal = nil
    local decalChild = head:FindFirstChildOfClass("Decal")
    if decalChild then
        originalDecal = decalChild:Clone()
        decalChild:Destroy()
    end
    
    local newSize = Config.HitboxSize
    head.Size = Vector3.new(newSize, newSize, newSize)
    head.Shape = Enum.PartType.Ball
    head.CanCollide = false
    head.Massless = true
    head.CastShadow = false
    head.Transparency = 0
    head.Color = originalColor
    head.Material = originalMaterial
    
    local visualMesh = Instance.new("SpecialMesh")
    visualMesh.MeshType = Enum.MeshType.Head
    visualMesh.Name = "VisualMesh"
    
    if originalMesh and originalMesh.MeshId and originalMesh.MeshId ~= "" then
        visualMesh.MeshId = originalMesh.MeshId
        visualMesh.TextureId = originalMesh.TextureId or ""
    end
    
    visualMesh.Scale = Vector3.new(
        (originalSize.X or 2) / newSize,
        (originalSize.Y or 1) / newSize,
        (originalSize.Z or 1) / newSize
    )
    visualMesh.Parent = head
    
    if originalDecal then originalDecal.Parent = head end
    
    modifiedCharacters[character] = {
        head = head,
        originalSize = originalSize,
        originalColor = originalColor,
        originalMaterial = originalMaterial,
        originalShape = originalShape,
        originalTransparency = originalTransparency,
        savedMesh = originalMesh,
        savedDecal = originalDecal,
    }
end

local function restoreHead(character)
    local data = modifiedCharacters[character]
    if not data then return end
    
    local head = data.head
    if head and head.Parent then
        local visualMesh = head:FindFirstChild("VisualMesh")
        if visualMesh then visualMesh:Destroy() end
        
        if data.savedMesh then data.savedMesh:Clone().Parent = head end
        if data.savedDecal then data.savedDecal:Clone().Parent = head end
        
        head.Size = data.originalSize or Vector3.new(2, 1, 1)
        head.Transparency = data.originalTransparency or 0
        head.Shape = data.originalShape or Enum.PartType.Block
        head.Color = data.originalColor
        head.Material = data.originalMaterial
        head.CastShadow = true
    end
    
    modifiedCharacters[character] = nil
end

local function updateHitboxSize(newSize)
    Config.HitboxSize = math.clamp(newSize, 1, 500)
    
    for character, data in pairs(modifiedCharacters) do
        local head = data.head
        if head and head.Parent then
            head.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
            local visualMesh = head:FindFirstChild("VisualMesh")
            if visualMesh then
                local origSize = data.originalSize or Vector3.new(2, 1, 1)
                visualMesh.Scale = Vector3.new(
                    origSize.X / Config.HitboxSize,
                    origSize.Y / Config.HitboxSize,
                    origSize.Z / Config.HitboxSize
                )
            end
        end
    end
    persistConfig()
end

local function setHitboxEnabled(enabled)
    Config.HitboxEnabled = enabled
    
    if enabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                transformHead(player.Character)
            end
        end
    else
        local characters = {}
        for character, _ in pairs(modifiedCharacters) do
            table.insert(characters, character)
        end
        for _, character in ipairs(characters) do
            restoreHead(character)
        end
    end
    persistConfig()
end

