-- KEYBINDS
-- ═══════════════════════════════════════════════════════════════

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    
    local key = input.KeyCode
    
    if key == Config.KeybindToggleGUI then
        mainFrame.Visible = not mainFrame.Visible
        return
    end
    
    if key == Config.KeybindToggleAll then
        local newState = not (Config.HitboxEnabled and Config.ESPEnabled)
        setHitboxEnabled(newState)
        setESPEnabled(newState)
        if setHitboxToggle then setHitboxToggle(newState) end
        if setESPToggle then setESPToggle(newState) end
        if setMasterToggle then setMasterToggle(newState) end
        return
    end
    
    if key == Config.AimbotToggleKey then
        if Config.AimbotMode == "Toggle" then
            local newState = not Config.AimbotEnabled
            setAimbotEnabled(newState)
            if setAimbotToggle then setAimbotToggle(newState) end
        else
            aimbotIsHolding = true
        end
        return
    end
    
    if key == Config.AimbotHoldKey and Config.AimbotMode == "Hold" then
        aimbotIsHolding = true
        return
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    
    if input.KeyCode == Config.AimbotToggleKey and Config.AimbotMode == "Hold" then
        aimbotIsHolding = false
    end
    
    if input.KeyCode == Config.AimbotHoldKey then
        aimbotIsHolding = false
    end
end)

