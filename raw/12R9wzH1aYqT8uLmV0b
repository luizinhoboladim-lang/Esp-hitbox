local activeKeybindListener = nil

local function startKeybindListening(button, onKeySelected, defaultText)
    if activeKeybindListener then
        activeKeybindListener.button.Text = activeKeybindListener.defaultText
    end
    button.Text = "..."
    activeKeybindListener = {
        button = button,
        callback = onKeySelected,
        defaultText = defaultText,
    }
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not activeKeybindListener then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard and
       input.UserInputType ~= Enum.UserInputType.MouseButton1 and
       input.UserInputType ~= Enum.UserInputType.MouseButton2 and
       input.UserInputType ~= Enum.UserInputType.MouseButton3 then return end
    
    local keyCode = input.KeyCode
    local keyName
    
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        keyName = "MouseButton1"; keyCode = nil
    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
        keyName = "MouseButton2"; keyCode = nil
    elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
        keyName = "MouseButton3"; keyCode = nil
    else
        keyName = keyCode.Name
    end
    
    if keyCode == Enum.KeyCode.Escape then
        activeKeybindListener.button.Text = activeKeybindListener.defaultText
        activeKeybindListener = nil
        return
    end
    
    local listener = activeKeybindListener
    activeKeybindListener = nil
    listener.button.Text = keyName
    if listener.callback then listener.callback(keyCode, keyName) end
end)

