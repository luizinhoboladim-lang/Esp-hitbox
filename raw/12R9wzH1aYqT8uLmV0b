local CONFIG_FILE = "LxzinnHE_config.json"

local function hasFileAPI()
    return typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
end

local function saveConfig(tbl)
    if hasFileAPI() then
        pcall(function() writefile(CONFIG_FILE, HttpService:JSONEncode(tbl)) end)
    end
end

local function loadConfig()
    if hasFileAPI() then
        local ok, data = pcall(function()
            if isfile(CONFIG_FILE) then return HttpService:JSONDecode(readfile(CONFIG_FILE)) end
        end)
        if ok and type(data) == "table" then return data end
    end
    return nil
end

local function keyToString(keyCode)
    if typeof(keyCode) == "EnumItem" then return keyCode.Name end
    return tostring(keyCode)
end

local function stringToKey(str)
    if not str then return nil end
    local ok, key = pcall(function() return Enum.KeyCode[str] end)
    if ok then return key end
    return nil
end

